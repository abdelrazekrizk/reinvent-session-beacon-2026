# Session-Beacon local environment template
# Non-secret values only. Do not commit real AWS access keys or tokens.
# Use AWS CLI SSO/profile authentication or set ephemeral shell credentials before deploy.

# Shared app/runtime settings
NODE_ENV=development
AWS_REGION=us-east-1
AWS_PROFILE=Session-Beacon-local
AWS_DEFAULT_REGION=us-east-1

# AWS / CDK deployment settings
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=us-east-1
SESSIONBEACON_ENV=dev
SESSIONBEACON_STACK_PREFIX=Session-Beacon
SESSIONBEACON_API_NAME=Session-Beacon-api
SESSIONBEACON_WS_NAME=Session-Beacon-realtime
SESSIONBEACON_DOMAIN=localhost
SESSIONBEACON_HOSTNAME=localhost
SESSIONBEACON_PUBLIC_URL=http://localhost:3000
SESSIONBEACON_API_URL=http://localhost:3001
SESSIONBEACON_WS_URL=ws://localhost:3002

# Cognito / hosted auth
COGNITO_USER_POOL_ID=
COGNITO_USER_POOL_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
COGNITO_LOGOUT_URI=http://localhost:3000/

# AWS Events API / Builder ID companion
EVENTS_API_BASE_URL=https://events-api.aws.dev
EVENTS_API_CLIENT_ID=
EVENTS_API_CLIENT_SECRET=
BUILDER_ID_AUTHORIZE_URL=
BUILDER_ID_TOKEN_URL=
BUILDER_ID_REDIRECT_URI=http://localhost:8484/callback
BUILDER_ID_SCOPE=events:read events:write
BUILDER_ID_LOCAL_PORT=8484

# SES / notifications
SES_FROM_EMAIL=no-reply@example.com
SES_REGION=us-east-1

# Bedrock / AI target settings
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MAX_RETRIES=2
BEDROCK_TIMEOUT_MS=5000
BEDROCK_GUARDRAILS_ENABLED=true

# DynamoDB / persistence
DYNAMODB_TABLE_PREFIX=Session-Beacon
DYNAMODB_TABLE=Session-Beacon-sessions
DYNAMODB_TTL_DAYS=90
DYNAMODB_ENCRYPTION=KMS

# Web / app config
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3002
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
VITE_APP_NAME=Session-Beacon
VITE_APP_ENV=development

# Observability / diagnostics
LOG_LEVEL=info
CLOUDWATCH_LOG_RETENTION_DAYS=30
X_RAY_TRACING_ENABLED=true

# Optional experimental feature flags
ENABLE_SCHEDULE_SYNC=false
ENABLE_TEAM_ANALYTICS=false
ENABLE_AGENTCORE=false
ENABLE_EVENTS_API_SYNC=false
ENABLE_BEDROCK_FALLBACK=true
