{
    "scripts":  {
                    "lint":  "turbo run lint",
                    "test":  "turbo run test",
                    "format":  "prettier --write \u0027**/*.{ts,tsx,js,jsx,json,md}\u0027",
                    "format:check":  "prettier --check \u0027**/*.{ts,tsx,js,jsx,json,md}\u0027",
                    "build":  "turbo run build",
                    "type-check":  "turbo run type-check",
                    "dev":  "turbo run dev",
                    "clean":  "turbo run clean \u0026\u0026 rm -rf node_modules dist .turbo"
                },
